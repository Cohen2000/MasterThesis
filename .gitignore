# Python and environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and editor state
.env
.env.*
!.env.example
*.key
*.pem
secrets/
.claude/
.codex/
.agents/
CLAUDE.local.md
.vscode/
.idea/
.DS_Store
*.swp

# Local empirical data and literature
/data/raw/*
!/data/raw/.gitkeep
/data/tokenizers/
/data/benchmark_*/
/literature/papers/

# Generated experiment artifacts
/results/**
!/results/README.md
/figures/generated/

# Prevent accidental addition of untracked bulk artifacts inside archives
/archive/**/results/**
/archive/**/logs/**

# Transient execution artifacts
*.log
*.pid
*.out
nohup.out
*.tmp
/local_logs*/
/tmp/
/scratch/
/prompts_shard_*
/outputs_shard_*
/answers_shard_*

# Models and caches
models/
checkpoints/
.cache/
huggingface/
wandb/
*.zip
*.tar.gz
