# Python and local environments
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local agent/editor state
.env
.env.*
!.env.example
*.key
*.pem
secrets/
.claude/
.codex/
.agents/
CLAUDE.local.md
.vscode/
.idea/
.DS_Store
*.swp

# Immutable local empirical data and literature
/data/raw/*
!/data/raw/.gitkeep
/literature/papers/

# Future generated data/results; keep the current landing page visible
/data/benchmark_*/
/results/**
!/results/README.md
/figures/generated/

# Transient execution artifacts and prompt/output shards
*.log
*.pid
*.out
nohup.out
*.tmp
/local_logs*/
/tmp/
/scratch/
/prompts_shard_*
/outputs_shard_*
/answers_shard_*

# Local models and caches
models/
checkpoints/
.cache/
huggingface/
wandb/
*.zip
*.tar.gz

